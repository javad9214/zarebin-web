# Baked into the bundle by `npm run build` (Vite picks this over .env in production builds).
# Empty on purpose: in production nginx (port 8084) proxies /api to the backend on the
# same server, so the app calls /api/... relatively — same origin, no CORS.
# Local dev keeps .env (http://localhost:8081) instead.
VITE_API_URL=
